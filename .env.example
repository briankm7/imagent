# Copia a .env solo si quieres hablar con proveedores reales.
# Sin .env el proyecto arranca en modo fake y todo funciona.

# fake | gemini
IMAGENT_PROVIDER_MODE=fake
# memory | qdrant
IMAGENT_VECTOR_STORE_MODE=memory
# memory | sqlite
IMAGENT_REPOSITORY_MODE=memory

# Obligatoria si IMAGENT_PROVIDER_MODE=gemini
# IMAGENT_GOOGLE_API_KEY=...
# IMAGENT_VISION_MODEL=gemini-2.5-flash
# IMAGENT_EMBEDDING_DIMENSIONS=768

# IMAGENT_QDRANT_URL=http://localhost:6333
# IMAGENT_SQLITE_PATH=./data/imagent.sqlite

# Presupuesto por consulta (secciones anidadas: doble guion bajo)
# IMAGENT_BUDGET__MAX_GRAPH_ITERATIONS=6
# IMAGENT_BUDGET__MAX_VISION_IMAGES=3
# IMAGENT_BUDGET__MAX_VISION_SECONDS=45
# IMAGENT_TIMEOUTS__RETRIEVAL_SECONDS=5
